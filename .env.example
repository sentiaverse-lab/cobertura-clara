# ─────────────────────────────────────────────────────────────
# Cobertura Clara — Configuracion
# Copia este archivo a ".env" y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (local). En despliegue la plataforma inyecta su propio PORT.
PORT=4700

# Motor de IA (compatible con la API de OpenAI: /v1/chat/completions)
# Puedes apuntar a cualquier proveedor OpenAI-compatible.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-tu-api-key-aqui
AI_MODEL=gpt-4o-mini
