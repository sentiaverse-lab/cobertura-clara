# ─────────────────────────────────────────────────────────────
# Cobertura Clara · asistente Vielsin — Configuracion
# Copia este archivo a ".env" y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (local). En despliegue la plataforma inyecta su propio PORT.
PORT=4700

# ── Cerebro del agente: cascada de proveedores (OpenAI-compatible) ──
# Se intentan en orden. El primero que responda gana. Todos son opcionales:
# sin ninguno configurado, el agente funciona en modo reglas locales.

# 1) Proveedor primario (rapido)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2) Proveedor secundario
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# 3) Respaldo (cualquier endpoint OpenAI-compatible)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Timeout por proveedor (ms) antes de pasar al siguiente
AI_TIMEOUT_MS=9000
